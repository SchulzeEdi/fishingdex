{
  "expo": {
    "name": "fishingdex",
    "slug": "fishingdex",
    "version": "0.1.0",
    "scheme": "fishingdex",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": { "supportsTablet": false },
    "android": {
      "package": "com.schulzeedi.fishingdex"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true }
  }
}
