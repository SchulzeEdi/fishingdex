{
  "name": "fishingdex",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "node scripts/db/run-sql.mjs src/shared/db/migrations",
    "db:seed": "node scripts/db/run-sql.mjs src/shared/db/seed",
    "db:reset": "node scripts/db/run-sql.mjs src/shared/db/migrations && node scripts/db/run-sql.mjs src/shared/db/seed",
    "build": "expo export --platform web --output-dir dist",
    "build:apk": "npx eas-cli@latest build --platform android --profile preview",
    "build:aab": "npx eas-cli@latest build --platform android --profile production",
    "submit:android": "npx eas-cli@latest submit --platform android --profile production",
    "brand:assets": "npm i --no-save @resvg/resvg-js && node scripts/brand/render-assets.mjs",
    "db:test:supabase": "node scripts/db/test-supabase.mjs",
    "android:emulator": "node scripts/android/emulator.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/sora": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.1",
    "drizzle-orm": "^0.45.2",
    "expo": "~58.1.0",
    "expo-constants": "~58.0.16",
    "expo-file-system": "~58.0.15",
    "expo-font": "~58.0.12",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.33",
    "expo-splash-screen": "~58.0.15",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.3.0",
    "@vitest/coverage-v8": "^1.6.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.3.3",
    "typescript": "~6.0.3",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
