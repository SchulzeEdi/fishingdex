# Backend/local. Copie para .env (git-ignored). Local = docker-compose (Postgres/PostGIS).
DATABASE_URL=postgres://fishingdex:fishingdex_dev_pw@localhost:5432/fishingdex

# Auth local (adapter bcrypt+JWT). Em produção, trocar por Supabase Auth (ADR-0003).
JWT_SECRET=dev_only_change_me

# App (Expo) — Supabase (valores públicos; ver eas.json)
EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...
